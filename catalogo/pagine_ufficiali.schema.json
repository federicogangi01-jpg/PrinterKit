{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "printerkit/catalogo/pagine_ufficiali.schema.json",
  "title": "Pagine ufficiali di download driver",
  "type": "object",
  "required": ["schemaVersion", "pagine"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string" },
    "pagine": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["manufacturer", "scope", "os", "arch", "pageUrl", "needsBrowser", "stato"],
        "additionalProperties": false,
        "properties": {
          "manufacturer": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "scope": { "enum": ["universale", "serie", "modello"] },
          "series": { "type": ["string", "null"] },
          "os": {
            "type": "array", "minItems": 1,
            "items": { "enum": ["windows-11", "windows-10", "windows-8.1", "windows-7", "windows-xp", "macos"] }
          },
          "arch": {
            "type": "array", "minItems": 1,
            "items": { "enum": ["x86", "x64", "arm64", "intel", "applesilicon"] }
          },
          "pageUrl": { "type": "string", "pattern": "^https://" },
          "needsBrowser": { "type": "boolean" },
          "notes": { "type": ["string", "null"] },
          "stato": { "enum": ["ok", "da_verificare", "nessun_driver"] },
          "verificatoIl": { "type": ["string", "null"] }
        }
      }
    }
  }
}
